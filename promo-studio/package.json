{
  "name": "areajam-promo-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:tts": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip edge-tts mutagen",
    "render": "node scripts/generate.mjs",
    "render:nashville": "node scripts/generate.mjs --city=Nashville --role=Drummers",
    "render:walkthrough": "node scripts/generate.mjs --preset=presets/youtube-walkthrough.json",
    "studio": "npx remotion studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.290",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.290"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
